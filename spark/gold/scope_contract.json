    "macro_indicator_observation": {
      "fact": "fact_macro_indicator",
      "datasets": [
        "world_bank_wdi"
      ],
      "grain": "country × indicator × year × source observation set",
      "metrics": [
        "indicator_value"
      ],
      "periods": [
        "YEAR"
      ],
      "geography": "M49 country",
      "units": [
        "indicator specific"
      ],
      "analysis_scope": "WDI indicator values; aggregation follows indicator rule"
    }
